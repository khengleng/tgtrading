# Required in Railway production. Never commit real values.
TELEGRAM_BOT_TOKEN=
SESSION_SECRET=
AUTHORIZED_TELEGRAM_IDS=
DATABASE_URL=
# Set to no-verify only for Railway's private Postgres connection, whose internal
# certificate chain is not publicly verifiable.
DATABASE_SSL_MODE=

# Optional, approved GoldPriceZ-compatible JSON feed. Do not set this to an HTML
# page without confirming permission and a supported access method.
GOLD_REFERENCE_FEED_URL=
GOLD_REFERENCE_API_KEY=
# Header name required by the provider, for example x-api-key or Authorization.
GOLD_REFERENCE_API_KEY_HEADER=x-api-key

# Development only. Must remain false in production.
ALLOW_LOCAL_DEMO=false
